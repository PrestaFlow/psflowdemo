{
    "name": "prestaflow/psflowdemo",
    "description": "Minimal PrestaShop module used as the PrestaFlow reference demo.",
    "license": "MIT",
    "type": "prestashop-module",
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/prestaflow/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/PrestaFlow/php-library"
        }
    ],
    "require-dev": {
        "prestaflow/php-library": "dev-dev"
    },
    "scripts": {
        "prestaflow": "./vendor-dev/prestaflow/php-library/bin/prestaflow run tests/prestaflow",
        "prestaflow:smoke": "./vendor-dev/prestaflow/php-library/bin/prestaflow run tests/prestaflow/Suites/Smoke.php",
        "prestaflow:json:file": "./vendor-dev/prestaflow/php-library/bin/prestaflow run --output=JSON ./tests --file"
    },
    "scripts-descriptions": {
        "prestaflow": "Run every PrestaFlow suite (needs a running shop, see .env.example).",
        "prestaflow:smoke": "Run the browser-free smoke suite only.",
        "prestaflow:json:file": "Run every suite and write prestaflow/results.json (used by PrestaFlow/github-action)."
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform-check": false,
        "vendor-dir": "vendor-dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
